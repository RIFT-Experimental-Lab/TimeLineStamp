#!/usr/bin/env python3
"""Keep private identifiers out of commit messages and trailers."""

import sys
from pathlib import Path


markers = (
    "andrew" + "sheff",
    "andrew" + "shevtsov",
    "andrei" + ".shevtsov",
    "andrew" + ".sheffff2012",
    "Анд" + "рей",
    "Шев" + "цов",
)
message = Path(sys.argv[1]).read_text(encoding="utf-8").casefold()
if any(marker.casefold() in message for marker in markers):
    sys.exit("Blocked: private identity found in commit message")
