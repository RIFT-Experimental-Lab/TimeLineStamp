<resources>
    <style name="DigitCell">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginHorizontal">1dp</item>
        <item name="android:background">@drawable/digit_cell</item>
        <item name="android:textColor">#EFBB7E</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:singleLine">true</item>
        <item name="android:text">—</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">12sp</item>
        <item name="android:autoSizeMaxTextSize">40sp</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:shadowColor">#60E9A45A</item>
        <item name="android:shadowRadius">4</item>
    </style>
</resources>
